ADMIN_ID=1337
BOT_TOKEN=123456789:abcdefghijklmnopqrstuvxwyz
MYSQL_HOST=127.0.0.1 # Use 'db' for Docker
MYSQL_PORT=3306
MYSQL_USER=myuser
MYSQL_PASSWORD=mypassword
MYSQL_DB=mydb
MYSQL_SOCKET=/run/mysqld/mysqld.sock

# Polling behaviour (all optional)
POLL_INTERVAL=10m       # base poll interval per feed; can be as low as 1m
POLL_INTERVAL_MAX=24h   # upper cap when adaptive slow-down is on
POLL_ADAPTIVE=true      # slow down feeds that rarely change (FRB023), set false to disable
POLL_CONCURRENCY=8      # max feeds fetched simultaneously
POLL_TICK=30s           # scheduler granularity (how often due feeds are checked)
